# Copy this file to .env and edit what you need.
# Nothing here is required: the defaults run against OpenAlex.
# Never put a real key in this file -- .env.example is committed, .env is not.


# --- Provider selection ---------------------------------------------------

# Provider used when a request does not name one.  OpenAlex is the default.
# RESEARCH_PROVIDER=openalex


# --- OpenAlex -------------------------------------------------------------

# Optional API key. Never put a real key in this file.
# OPENALEX_API_KEY=

# Optional but recommended.  OpenAlex is free and community-funded, and gives
# identified traffic better throughput ("polite pool").
# OPENALEX_MAILTO=you@example.com


# --- Semantic Scholar -----------------------------------------------------

# Semantic Scholar stays disabled until one of the two settings below is set,
# because unauthenticated traffic to its API is aggressively rate limited.
# Request a key at https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=

# Deliberate opt-in to run without a key and accept the rate limits.
# SEMANTIC_SCHOLAR_ALLOW_UNAUTHENTICATED=0


# --- Search volume / politeness -------------------------------------------

# Pages per search (1-20) and results per page (1-200).  Every page is a real
# HTTP request to a free service, so keep these modest.
# SEARCH_PAGES=3
# SEARCH_PER_PAGE=100

# Conservative relevance cutoff and display bands (0..100). Results below the
# cutoff are excluded before Research Score and persistence.
# RELEVANCE_MIN_SCORE=20
# RELEVANCE_MEDIUM_SCORE=30
# RELEVANCE_HIGH_SCORE=50

# Seconds before a single provider request times out.
# REQUEST_TIMEOUT=30

# Retries for retryable failures only (0-5), the exponential backoff base, and
# the hard ceiling on any single sleep.
# MAX_RETRIES=2
# RATE_LIMIT_RETRIES=1
# MAX_RATE_LIMIT_WAIT_SECONDS=60
# RETRY_BACKOFF_SECONDS=2.0
# MAX_BACKOFF_SECONDS=10.0

# Courtesy pause between paged requests to the same provider, in seconds.
# INTER_PAGE_DELAY=0.3

# One honest User-Agent.  Identify yourself; never impersonate a browser.
# USER_AGENT=SemanticResearchEngine/2.0 (academic research)


# --- Database -------------------------------------------------------------

# Path to the SQLite file.  Defaults to papers.db next to the code, so the
# database does not change when the server is started from another directory.
# RESEARCH_DATABASE_PATH=

# Full SQLAlchemy URL, overriding RESEARCH_DATABASE_PATH entirely.
# RESEARCH_DATABASE_URL=


# --- Concept / topic pipeline ---------------------------------------------

# Minimum provider confidence for a concept to be kept (0..1), the deepest
# concept level accepted, and the cap per paper.
# CONCEPT_MIN_SCORE=0.30
# CONCEPT_MAX_LEVEL=5
# CONCEPT_MAX_PER_PAPER=12


# --- Trend analysis thresholds --------------------------------------------

# Papers a year needs before its topic shares are trusted.
# TREND_MIN_PAPERS_PER_YEAR=5

# Occurrences a topic needs in total, and in the recent window, before it can
# be classified at all.
# TREND_MIN_TOTAL_OCCURRENCES=5
# TREND_MIN_RECENT_OCCURRENCES=3

# Relative change in normalized share required to call a topic growing or
# declining (0.50 == +/-50%).
# TREND_GROWTH_THRESHOLD=0.50

# Years per comparison window (recent window vs the window before it).
# TREND_WINDOW_YEARS=5

# Fraction of reliable years a topic must appear in to count as persistent.
# TREND_PERSISTENCE_RATIO=0.60

# How many topics each trend list returns, and topics shown per year.
# TREND_TOP_N=10
# TREND_TOPICS_PER_YEAR=5
